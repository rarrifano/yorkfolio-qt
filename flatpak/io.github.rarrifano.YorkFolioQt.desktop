[Desktop Entry]
Type=Application
Name=YorkFolio Desktop
GenericName=Portfolio tracker
GenericName[pt_BR]=Carteira de investimentos
Comment=Holder-style portfolio tracker for B3 investors
Comment[pt_BR]=Carteira de investimentos para investidores da B3
Exec=yorkfolio-qt %F
Icon=io.github.rarrifano.YorkFolioQt
Terminal=false
Categories=Office;Finance;Qt;KDE;
Keywords=portfolio;investments;B3;bolsa;stocks;carteira;
Keywords[pt_BR]=carteira;investimentos;B3;bolsa;ações;proventos;IR;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;
StartupWMClass=io.github.rarrifano.YorkFolioQt
StartupNotify=true
X-KDE-StartupNotify=true
X-KDE-FormFactor=desktop;
