<component type="desktop-application">
  <id>io.github.rarrifano.YorkFolioQt</id>
  <name>YorkFolio Desktop</name>
  <summary>Holder-style portfolio tracker for B3 investors</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.rarrifano"><name>rarrifano</name></developer>
  <url type="homepage">https://github.com/rarrifano/yorkfolio-qt</url>
  <url type="bugtracker">https://github.com/rarrifano/yorkfolio-qt/issues</url>
  <description>
    <p>
      Import the Excel statements from the B3 investor portal and see your positions with average price,
      net worth and returns over time against CDI and Ibovespa, and your proventos.
    </p>
    <p>
      It also suggests aportes towards your target allocation and prepares your IR: the monthly DARF and the
      annual Bens e Direitos. Everything is stored locally in a SQLite file; the interface is in Brazilian Portuguese.
    </p>
    <p>A C++ core computes positions, taxes and the aporte plan; the interface is written in Python with Qt.</p>
  </description>
  <url type="vcs-browser">https://github.com/rarrifano/yorkfolio-qt</url>
  <keywords><keyword>portfolio</keyword><keyword>B3</keyword><keyword>carteira</keyword><keyword>investimentos</keyword></keywords>
  <branding><color type="primary" scheme_preference="light">#3daee9</color><color type="primary" scheme_preference="dark">#1d6f9b</color></branding>
  <launchable type="desktop-id">io.github.rarrifano.YorkFolioQt.desktop</launchable>
  <provides><binary>yorkfolio-qt</binary></provides>
  <screenshots>
    <screenshot type="default">
      <caption>Net worth over time, allocation and positions with average price</caption>
      <image>https://raw.githubusercontent.com/rarrifano/yorkfolio-qt/v0.1.1/docs/screenshots/carteira.png</image>
    </screenshot>
    <screenshot>
      <caption>Proventos (dividends and other income) by month, year, type and asset</caption>
      <image>https://raw.githubusercontent.com/rarrifano/yorkfolio-qt/v0.1.1/docs/screenshots/proventos.png</image>
    </screenshot>
    <screenshot>
      <caption>Allocation targets and a suggested aporte (new investment)</caption>
      <image>https://raw.githubusercontent.com/rarrifano/yorkfolio-qt/v0.1.1/docs/screenshots/balanceamento.png</image>
    </screenshot>
    <screenshot>
      <caption>Income tax: monthly results and DARF, plus the annual Bens e Direitos</caption>
      <image>https://raw.githubusercontent.com/rarrifano/yorkfolio-qt/v0.1.1/docs/screenshots/ir.png</image>
    </screenshot>
  </screenshots>
